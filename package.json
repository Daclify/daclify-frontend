{
  "name": "@daclify/frontend",
  "version": "0.4.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21 <25",
    "npm": ">=11.19 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vitest run tests/unit/lint-policy.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"**/*.{ts,vue,css,json}\"",
    "format": "prettier --write \"**/*.{ts,vue,css,json}\""
  },
  "dependencies": {
    "@daclify/core-protocol": "file:../daclify-backend-core/.artifacts/daclify-core-protocol-0.4.0-alpha.1.tgz",
    "@daclify/modules": "file:../daclify-backend-modules/.artifacts/daclify-modules-0.4.0-alpha.1.tgz",
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/vue": "1.52.0",
    "@wharfkit/antelope": "4.0.2",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "allowScripts": {
    "fsevents": false
  }
}
