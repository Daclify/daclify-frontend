# Public frontend deployment settings ONLY; no provider or signing secrets.
# Copy to .env.production, confirm the API addresses, then: npm run build
# Vite embeds these URLs in the bundle. Rebuild/redeploy after changing them.
# The selected origin is required and must be HTTPS without credentials/path/query/hash.
# These are the planned hosted services; they must be deployed independently.
VITE_NETWORK=production
VITE_API_PRODUCTION=https://api.daclify.com
# This deployment is locked to production and ignores saved browser choices.
# For a testnet build, use VITE_NETWORK=testnet and VITE_API_TESTNET instead.
