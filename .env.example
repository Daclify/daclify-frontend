# Optional build-time fallback used only when /networks.json is missing.
# A deployed server should replace public/networks.json with both https origins.
# Local development keeps {"mode":"local"} and uses the Vite /v1 proxy.
# VITE_API_PRODUCTION=https://replace-with-the-production-api-origin.example
# VITE_API_TESTNET=https://replace-with-the-testnet-api-origin.example
