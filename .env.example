# Frontend public settings ONLY. Copy to .env for local development.
# Never put signing keys, SMTP passwords, Pinata JWTs or provider secrets here.
# Vite loads these dev-server ports; shell values override the file.
DACLIFY_TEST_UI_PORT=5178
DACLIFY_TEST_API_PORT=3008
# Start: npm run dev. /v1 is proxied to the loopback backend API port above.

# Optional development-only direct HTTPS API, overriding networks.json.
# See .env.testnet.example and core docs/development.md for local HTTPS setup.
# VITE_API_ORIGIN=https://your-testnet-api-origin.example
# DACLIFY_TEST_HOST=dev.app.daclify.com
# DACLIFY_TEST_HTTPS_CERT=.artifacts/devcert/cert.pem
# DACLIFY_TEST_HTTPS_KEY=.artifacts/devcert/key.pem

# Optional public build-time fallback; both HTTPS origins must be supplied.
# Used ONLY when /networks.json returns 404. A deployed server should replace
# public/networks.json with both API origins. Committed {"mode":"local"} uses /v1.
# VITE_API_PRODUCTION=https://your-production-api-origin.example
# VITE_API_TESTNET=https://your-testnet-api-origin.example
