# Public frontend settings for the local UI connected to public Telos testnet.
# Copy to .env.testnet, then start: npm run dev -- --mode testnet
# Open http://testnet.localhost:5198 (separate browser cookies from local fixtures).
# Backend: DACLIFY_ENV_FILE=.env.testnet npm run dev, API_PORT=3028.
DACLIFY_TEST_UI_PORT=5198
DACLIFY_TEST_API_PORT=3028
# API must allow FRONTEND_ORIGIN=http://testnet.localhost:5198.
# NETWORK_ENVIRONMENT belongs in the BACKEND .env.testnet; this file sets ports.
# Chain/account/provider/private-key settings never belong in frontend env files.

# Optional: develop locally against the HTTPS API hosted on Hetzner.
# This dev-only override ignores networks.json and hides the network switch.
# VITE_API_ORIGIN=https://your-testnet-api-origin.example
# For reliable login cookies, use a local HTTPS hostname under the same site
# as the API; map it to 127.0.0.1 on this Mac and supply a trusted certificate.
# DACLIFY_TEST_HOST=dev.app.daclify.com
# DACLIFY_TEST_HTTPS_CERT=.artifacts/devcert/cert.pem
# DACLIFY_TEST_HTTPS_KEY=.artifacts/devcert/key.pem
# Hosted API must include https://dev.app.daclify.com:5198 in its explicit
# FRONTEND_ADDITIONAL_ORIGINS list. Leave the mainnet list unchanged.
